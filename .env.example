# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co

# Public client key. Use EITHER the new publishable key (sb_publishable_...) OR
# the legacy anon key — set whichever one you have under either name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret. Never exposed to the client. Used for first-sign-in
# profile provisioning and trusted server reads. Use EITHER the new secret key
# (sb_secret_...) OR the legacy service_role key, under either name.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection string (Supabase → Connect → transaction pooler, port 6543).
# Used by Drizzle ORM and drizzle-kit migrations.
DATABASE_URL=postgres://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
