# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never exposed to the client. Used for first-sign-in profile
# provisioning and trusted server reads. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Supabase pooler). Settings → Database.
# Used by Drizzle ORM and drizzle-kit migrations.
DATABASE_URL=postgres://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
